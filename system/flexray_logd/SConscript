Import('env', 'arch')

if arch != 'Darwin':
  local_env = env.Clone()
  local_env.Append(CPPPATH=[Dir('.').abspath, Dir('libftdi').abspath, '/usr/include/libusb-1.0'])
  ftdi = local_env.StaticLibrary('libftdi/ftdi', ['libftdi/ftdi.c'])
  spi = local_env.StaticLibrary('libftdi/ftdispi', ['libftdi/ftdispi.c'])
  for target in ['flexray_logd', 'flexray_dump']:
    local_env.Program(target, [target + '.c', 'flexray_capture.c', 'flexray_output.c', 'flexray_reader.c', 'flexray_decoder.c', spi, ftdi],
                      LIBS=['usb-1.0', 'pthread'])
